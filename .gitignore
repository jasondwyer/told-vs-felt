# External tool clone (see CLAUDE.md setup instructions) — not vendored here
/jlens-qwen36/

# Generated artifacts (lens fits, fingerprints, logs)
/data/*
!/data/.gitkeep

# Exception (ledger 27, applied 2026-08-12): verdict-relevant analysis
# artifacts enter the record. Text artifacts only — weight/residual .npz
# stay local. Exceptions are per-directory and deliberate, never blanket.
!/data/f/
/data/f/*
!/data/f/*.json
!/data/f/*.jsonl

# Rule-26 oracle set (added 2026-08-12): the reference values the
# refactor regression law is accepted against must live in the record,
# not on one laptop.
!/data/e2a/
/data/e2a/*
!/data/e2a/*.json
!/data/e2a/*.jsonl

# e2b artifacts (PROPOSAL-h §6). The power arithmetic and the H3 screen are
# both instruments a later run has to be able to re-derive, not outputs.
!/data/e2b/
/data/e2b/*
!/data/e2b/*.json
!/data/e2b/*.jsonl
# OLMo checkpoint manifest (step 2): shas, dtypes, param counts. The
# weights stay on the box; the provenance record travels (ledger 27).
!/data/olmo/
/data/olmo/*
!/data/olmo/*.json

# (d) conditioning gates: paper_data.py sources, required for the 0b
# DATA-root flip at paper-1. JSON only -- teacher_cache/ and adapter
# weights stay local.
!/data/d/
/data/d/*
!/data/d/*.json

!/data/e0/
/data/e0/*
!/data/e0/*.json
# Frozen DIRECTION artifacts only (~1.2 MB): rule 1 sha-verifies against
# these and every published dose is a fraction of the R_l in the meta.
# Named explicitly -- e0_residuals.npz (202 MB of raw residuals) stays local,
# and a bare *.npz exception would sweep it in.
!/data/e0/e0_axes.npz
!/data/e0/e0_random_dirs.npz
# S2's vignette axis (492 KB): the third neighbour, extracted 2026-08-20.
# Same standing as the two above -- a frozen, sha-pinned direction the
# discriminant table is computed against, and the only panel member that
# does not already live in e0_axes.npz.
!/data/e0/s2_vignette_axis.npz
# B1 marker battery (47.5 MB): the source the 12 B2b instruments are
# recomputed from. Large, and admitted deliberately -- rule-26 criterion (ii)
# rebuilds the instruments from THIS file, so storing only the derived
# instruments would mean trusting a computation we could no longer check.
# e0_residuals.npz (202 MB) remains excluded.
!/data/e0/e0_b1_markers.npz
# A-phase per-stage axis families (431 KB each, 4 stages): the frozen
# feedback-contrast direction plus its V2/V3 guards, per checkpoint.
# Same standing as the e0 axes above -- box_a4_hijack.py doses from these
# and sha-verifies the family, so a copy that lives only on an ephemeral
# box does not exist (ledger 27). Named explicitly for the same reason: a
# bare *.npz exception would sweep in raw residuals.
!/data/olmo/a3_axes_base.npz
!/data/olmo/a3_axes_sft.npz
!/data/olmo/a3_axes_dpo.npz
!/data/olmo/a3_axes_instruct.npz
# A4 per-stage marker stores (~50 MB each, 198 MB for four): the top-4096
# sparse next-token log-probs the 12 per-probe instruments -- and therefore
# G_c, the currency every B-phase effect is denominated in -- are rebuilt
# from. Admitted on the same reasoning as e0_b1_markers.npz: storing only
# the derived instruments would mean trusting a computation we could no
# longer check. top_ids re-encoded int64 -> int32 (lossless; ids <= 100269).
!/data/olmo/a4_instrument_base.npz
!/data/olmo/a4_instrument_sft.npz
!/data/olmo/a4_instrument_dpo.npz
!/data/olmo/a4_instrument_instruct.npz

# Ledger-26 regression verdicts: the record of whether a refactor was
# accepted belongs in the repo, not on the machine that ran it (ledger 27).
!/data/regression/
/data/regression/*
!/data/regression/*.json

# r3 confirmatory gate results: the matched-pair criterion (rule 9) is
# regression-tested against these, and the ledger-26 analysis suite must be
# runnable on the box. Named explicitly -- data/configs/ otherwise stays local.
!/data/configs/
/data/configs/*
!/data/configs/c1r3_gate_repA.json
!/data/configs/c1r3_gate_repB.json
# e0 frame set: the frozen extraction stimulus. Phase 1 reruns the SAME
# text on every checkpoint, so it has to be in the record, not one clone.
!/data/configs/e0_frames.json
# e0 probe set: the 12 readout probes the B1/B2 instruments are indexed by.
!/data/configs/e0_probes.json
# A1 candidate roster: the eight pairs the box-side screen runs and the
# token ids they were verified at. The screen is per-stage and the selection
# is cross-stage, so both sites read this file; a roster that lived on one
# machine would make the screens non-comparable.
!/data/configs/a1_roster_candidates.json
# S2 vignette frames: the only neighbour stimulus the repo did not already
# have. Committed so the design instance can replace the stimulus by editing
# a file, and so the axis it produces is traceable to exact text.
!/data/configs/s2_vignette_frames.json
# H3 candidate roster: the Qwen-side tag screen PROPOSAL-h §2 gates e2b
# on. Committed because the roster it locks is the instrument every e2b
# session is read through.
!/data/configs/h3_roster_candidates.json
# e2a scaffold ban list (12 special-token ids, frozen 2026-08-09).
# Applied at ROUND GENERATION ONLY, never at a choice forward. H2 and
# every later e2b session depend on it, and it lived only in the
# gitignored clone until 2026-08-21 -- an input that lives only there
# makes the run unreproducible on any other machine.
!/data/configs/e2a_ban_list.json
# e2b revised degeneracy audit (v2), approved 2026-08-21 and frozen for
# the H1 campaign. The monitor a campaign ran under is part of its
# record, and its sha is printed in the run header.
!/data/configs/e2b_audit_v2.json
# f termination-attempt patterns (adjudication 27446d3): descriptive,
# non-gating, tabulated over ALL sessions including excluded ones. The
# e2b verdict tier retains the counter (PROPOSAL-h §5), so the patterns
# travel with the record rather than living only in the clone.
!/data/configs/f_termination_patterns.json
# B2 concept materials, recovered verbatim from Macar et al. at a pinned
# commit sha: their 50 test concepts and 100 baseline words, the extraction
# method, and the rule-18 collision report. The fidelity arm replicates
# their paradigm, so these words ARE the experiment and the file has to
# travel with the record rather than sit on one laptop.
!/data/configs/b2_concepts.json

# e0 task corpus (48 tasks): the other half of the frozen 1,344-context
# extraction stimulus.
!/data/corpus/
/data/corpus/*
!/data/corpus/*.jsonl

# Local agent settings (Cowork / Claude Code) — machine-local, not shared
/.claude/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
